# dropbot .env — COPY this file to `.env` on the VPS and fill the values.
# NEVER paste a token or key in chat. Token sirf VPS par .env me.
# File: /opt/dropbot/.env

# --- REQUIRED: new bot token (BotFather se banaya hua dropbot token) ---
DROPBOT_TOKEN=

# --- REQUIRED: Telegram API id/hash (my.telegram.org) — userbot ke liye ---
# Main bot ki /opt/bot/.env wali USERBOT_API_ID / USERBOT_API_HASH hi use karo.
DROPBOT_API_ID=
DROPBOT_API_HASH=

# --- REQUIRED: @Wizard_Scan userbot session ---
# Main bot ki /opt/bot/data/userbot_session2.txt file ko copy karo:
#   cp /opt/bot/data/userbot_session2.txt /opt/dropbot/wizard_scan.session
# Yeh ek StringSession TEXT file hai (SQLite .session file nahi).
DROPBOT_SESSION=/opt/dropbot/wizard_scan.session

# --- Target channel (dropped calls yahan post hongi) ---
DROPBOT_TARGET_CHANNEL=@WizardScan

# --- Data dir (dropbot ka apna record yahan) ---
DROPBOT_DATA_DIR=/opt/dropbot/data

# --- Owner (alerts/DM ke liye; optional) ---
DROPBOT_OWNER_ID=6018602211
DROPBOT_OWNER_ID_2=2131647292

# --- MC fetch keys (main bot ki /opt/bot/.env wali keys hi use karo) ---
BIRDEYE_API_KEY=
MORALIS_API_KEY=
CMC_API_KEY=
EXTRA_SOURCES_ENABLED=1

# --- Dropped-call timing (main bot ke .env jaisi values) ---
POST_MIN_SECONDS=1
POST_MAX_SECONDS=2
RH_PRE_POST_MIN_SECONDS=10
RH_PRE_POST_MAX_SECONDS=60
LATE_ENTRY_HIST_SECONDS=60
DROP_CONFIRM_TIMEOUT_SEC=0.5
DROP_SETTLE_SECONDS=0.2

# --- RT queue (optional, defaults theek hain) ---
RT_MAX_QUEUE_AGE_SECONDS=600
RT_SEND_TIMEOUT_SECONDS=20
RT_MAX_SEND_RETRIES=2
